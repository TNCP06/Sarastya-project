# Sarastya Drive (scd) — copy to `.env` and fill in. Consumed by docker-compose for the
# whole stack (postgres, api, web, bot, watcher, streamer, telegram-bot-api, cloudflared).
# DO NOT commit `.env`. This stack is isolated from the existing `tcd` stack (DB=scd, scd-* names).

# ── Compose ───────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=scd     # keeps containers/volumes namespaced; or use `docker compose -p scd`

# ── Telegram (NEW bot + NEW storage channel for scd — not the tcd ones) ────────
BOT_TOKEN=                   # @BotFather token for the NEW scd bot (bot.py + web purge/thumbnail)
STORAGE_CHANNEL_ID=          # NEW private channel id, e.g. -1004389513033 (new bot must be admin)
OWNER_USER_ID=               # your Telegram user id (download + Bot Drop allowlist)
NEXT_PUBLIC_BOT_USERNAME=    # NEW bot username WITHOUT @ (inlined into web at build time)
# Copy these two from the VPS ~/tcd/.env (per-account, reusable across bots):
TG_API_ID=                   # my.telegram.org (watcher / streamer Telethon)
TG_API_HASH=                 # my.telegram.org (watcher / streamer Telethon)
# TELEGRAM_API_URL is set by docker-compose (http://scd-telegram-bot-api:8081); override only off-Docker.

# ── PostgreSQL (self-hosted scd-postgres service) ─────────────────────────────
# DB name/user default to `scd` (distinct from tcd's `cdt`). DATABASE_URL is what the Python
# engine (bot/watcher/streamer) and web's binary routes connect with — host = scd-postgres.
POSTGRES_USER=scd
POSTGRES_PASSWORD=           # REQUIRED — strong, NEW password (do not reuse tcd's)
POSTGRES_DB=scd
DATABASE_URL=postgresql://scd:CHANGEME@scd-postgres:5432/scd   # must match the three vars above

# ── .NET API (scd-api) ────────────────────────────────────────────────────────
# The API builds its ConnectionStrings__Default from POSTGRES_* above. These configure JWT + CORS.
JWT_SECRET=                  # REQUIRED — >= 32 random bytes (HS256 signing key)
JWT_EXPIRES_IN_HOURS=24
ALLOWED_ORIGINS=http://localhost:3100   # browser origins allowed to call the API directly (dev/Swagger)

# ── Public access (Cloudflare Tunnel → drive + stream domains) ────────────────
# Configure Public Hostnames in the Cloudflare dashboard:
#   drive.tncp.web.id  → http://scd-web:3000
#   stream.tncp.web.id → http://scd-streamer:8080
CLOUDFLARE_TUNNEL_TOKEN=     # token from `cloudflared tunnel run --token …`; empty = no tunnel
STREAMER_SECRET=             # shared secret guarding the streamer; empty = no check (internal-only)

# ── Legacy shared gate (optional; superseded by per-user JWT) ──────────────────
# Keep only if a web route still needs the old shared password/PIN during transition.
APP_PASSWORD=                # shared dashboard password; empty = disabled
PIN=                         # numeric PIN for the Private space; empty = Private disabled

# ── Subtitle generation (optional; Groq Whisper STT + translation) ────────────
GROQ_API_KEYS=               # comma-separated Groq keys (copy from ~/tcd/.env); empty = no subtitles
# Optional STT failover via Cloudflare Workers AI Whisper (copy from ~/tcd/.env if used):
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Telethon session names (sessions themselves are gitignored; create on the VPS) ──
WORKER_SESSION=worker        # → bot/worker.session
STREAMER_SESSION=streamer    # → bot/streamer.session
